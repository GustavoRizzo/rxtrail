# Copy to .env. Host ports are configurable so this stack can run beside others.

# Host user: containers write into the working tree as this uid/gid.
HOST_UID=1000
HOST_GID=1000

# Web app and database.
WEB_PORT=8142
POSTGRES_PORT=55532

# Postgres. The superuser is for administration only; the app uses its own
# user, which owns the `transactional` schema and nothing else.
POSTGRES_DB=rxtrail
POSTGRES_USER=rxtrail
POSTGRES_PASSWORD=rxtrail
POSTGRES_HOST=db
POSTGRES_INTERNAL_PORT=5432
TRANSACTIONAL_DB_USER=transactional
TRANSACTIONAL_DB_PASSWORD=transactional

# Django
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solana network the app talks to: localnet | devnet.
SOLANA_NETWORK=localnet
# Optional overrides (e.g. a paid provider):
# SOLANA_RPC_URL=
# SOLANA_WS_URL=

# Local validator (just localnet): JSON-RPC and WebSocket.
LOCALNET_RPC_PORT=59899
LOCALNET_WS_PORT=59900
# Transaction history the local validator keeps, in shreds (2M ~ 1 day).
LOCALNET_LEDGER_SHREDS=2000000
