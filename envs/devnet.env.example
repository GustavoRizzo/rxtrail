# Environment: RxTrail on devnet, Solana's public test network.
# Copy to envs/devnet.env. One environment = one network = one database =
# one key set (.keys/devnet/). No local validator in this environment.
RXTRAIL_NETWORK=devnet
SOLANA_NETWORK=devnet
COMPOSE_PROFILES=

HOST_UID=1000
HOST_GID=1000

WEB_PORT=8143
POSTGRES_PORT=55533

POSTGRES_DB=rxtrail_devnet
POSTGRES_USER=rxtrail
POSTGRES_PASSWORD=rxtrail
POSTGRES_HOST=db
POSTGRES_INTERNAL_PORT=5432
TRANSACTIONAL_DB_USER=transactional
TRANSACTIONAL_DB_PASSWORD=transactional

DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: a paid RPC provider instead of the public endpoints.
# SOLANA_RPC_URL=
# SOLANA_WS_URL=
