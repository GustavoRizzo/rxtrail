# Environment: RxTrail on a private local validator (development, tests).
# Copy to envs/localnet.env. One environment = one network = one database =
# one key set (.keys/localnet/).
RXTRAIL_NETWORK=localnet
SOLANA_NETWORK=localnet
# Start the local validator with this environment.
COMPOSE_PROFILES=validator

# Host user: containers write into the working tree as this uid/gid.
HOST_UID=1000
HOST_GID=1000

# Host ports (each environment has its own, so both can run at once).
WEB_PORT=8142
POSTGRES_PORT=55532
LOCALNET_RPC_PORT=59899
LOCALNET_WS_PORT=59900

# Postgres. The superuser is for administration only; the app connects as its
# own user, which owns the `transactional` schema and nothing else.
POSTGRES_DB=rxtrail_localnet
POSTGRES_USER=rxtrail
POSTGRES_PASSWORD=rxtrail
POSTGRES_HOST=db
POSTGRES_INTERNAL_PORT=5432
TRANSACTIONAL_DB_USER=transactional
TRANSACTIONAL_DB_PASSWORD=transactional

DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Transaction history the local validator keeps, in shreds (2M ~ 1 day).
LOCALNET_LEDGER_SHREDS=2000000
